{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "remoteCache": {
    "enabled": false
  },
  "boundaries": {
    "tags": {
      "core": {
        "dependencies": {
          "allow": []
        }
      },
      "react": {
        "dependencies": {
          "allow": ["core"]
        }
      },
      "next": {
        "dependencies": {
          "allow": ["core", "react"]
        }
      }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@fast-link/fixture-next-16#typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "size": {
      "dependsOn": ["build"]
    },
    "@fast-link/core#test:browser": {
      "dependsOn": ["build"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/test-core-targeting.mjs"
      ]
    },
    "@fast-link/fixture-next-16#test:fixtures": {
      "dependsOn": ["build"],
      "cache": false
    },
    "//#format": {
      "cache": false
    },
    "//#lint": {
      "cache": false
    },
    "//#test:root": {
      "inputs": [
        "scripts/**",
        ".github/workflows/**",
        "package.json",
        "pnpm-lock.yaml"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
