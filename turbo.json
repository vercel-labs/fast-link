{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "remoteCache": {
    "enabled": false
  },
  "boundaries": {
    "tags": {
      "core": {
        "dependencies": {
          "allow": []
        }
      },
      "react": {
        "dependencies": {
          "allow": ["core"]
        }
      },
      "next": {
        "dependencies": {
          "allow": ["core", "react"]
        }
      }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@fast-link/fixture-next-16#typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts"]
    },
    "size": {
      "dependsOn": ["build"]
    },
    "@fast-link/core#test:browser": {
      "dependsOn": ["build"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/browser/**"]
    },
    "@fast-link/fixture-next-16#test:fixtures": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["FAST_LINK_FIXTURE_DIR"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/browser/**"]
    },
    "//#format": {
      "cache": false
    },
    "//#lint": {
      "cache": false
    },
    "//#test:root": {
      "inputs": [
        "scripts/**",
        "vitest.config.mjs",
        ".pnpmfile.cjs",
        ".github/workflows/**",
        ".github/actions/**",
        "package.json",
        "pnpm-lock.yaml"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#test:compatibility": {
      "dependsOn": ["@fast-link/next#build"],
      "cache": false
    },
    "//#typecheck:examples": {
      "dependsOn": ["@fast-link/next#build"],
      "inputs": [
        "scripts/documentation/**",
        "README.md",
        "packages/*/README.md",
        "skills/fast-link/**",
        "pnpm-lock.yaml"
      ]
    }
  }
}
