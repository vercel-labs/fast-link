{
  "name": "@fast-link/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install || true",
    "size": "turbo run size",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "test:fixtures": "turbo run test:fixtures",
    "test:root": "vitest run --globals scripts/*.spec.mjs",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run //#format //#lint //#test:root build typecheck test test:browser test:fixtures size"
  },
  "devDependencies": {
    "lefthook": "2.1.5",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "playwright": "1.59.0",
    "turbo": "2.10.13",
    "vitest": "4.1.11",
    "yaml": "2.8.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.32.1"
}
