{
  "name": "@fast-link/core",
  "version": "0.0.2",
  "description": "DOM controller for same-origin mouse navigation on pointerdown",
  "author": "Vercel",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/vercel-labs/fast-link.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --project=unit",
    "test:browser": "vitest run --project=browser && node ../../scripts/test-core-targeting.mjs",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "12.1.0",
    "@types/node": "25.6.0",
    "@vitest/browser-playwright": "4.1.11",
    "jsdom": "23.2.0",
    "playwright": "1.59.0",
    "size-limit": "12.1.0",
    "tsdown": "0.21.7",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.32.1"
}
