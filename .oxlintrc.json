{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "error",
    "nursery": "off"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undefined": "off",
    "typescript/explicit-function-return-type": "off",
    "no-rest-spread-properties": "off",
    "no-use-before-define": "off",
    "no-optional-chaining": "off",
    "no-async-await": "off",
    "no-plusplus": "off",
    "prefer-template": "error"
  },
  "overrides": [
    {
      "files": ["packages/core/src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(react|next)(/|$)",
                "message": "Core must stay framework agnostic."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/next/src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(next/dist(/|$)|@vercel/microfrontends(/|$)|@pyra(/|$))",
                "message": "The Next adapter must use public Next.js interfaces."
              }
            ]
          }
        ]
      }
    }
  ]
}
